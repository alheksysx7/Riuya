FROM node:24.22.1-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --chown=node:node src/worker ./src/worker
COPY --chown=node:node scripts/worker-service.mjs ./scripts/worker-service.mjs
USER node
CMD ["node","scripts/worker-service.mjs"]
